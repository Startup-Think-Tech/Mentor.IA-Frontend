# Ambiente público de execução. O Next define NODE_ENV automaticamente como
# development para `next dev` e production para `next start`.
# A porta usa 3000 por padrão. Para alterá-la, defina PORT no ambiente do processo
NEXT_PUBLIC_APP_ENV=development

# Base URL da API NestJS.
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1

# API pública usada para renderizar o conteúdo das questões referenciadas pela API.
NEXT_PUBLIC_ENEM_API_URL=https://api.enem.dev/v1
